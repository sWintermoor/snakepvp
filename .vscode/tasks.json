{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "cmake-build",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/build",
                "--config",
                "Debug"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$msCompile"]
        },
        {
            "label": "run-universe",
            "type": "shell",
            "command": "${workspaceFolder}/build/Debug/universe.exe",
            "dependsOn": ["cmake-build"],
            "group": {
                "kind": "test",
                "isDefault": true
            }
        }
    ]
}